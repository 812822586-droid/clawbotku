# Copy this file to .env and fill in real tokens there.
# .env is gitignored. Never commit real secrets.

# Optional prefix added to every echo. Default is "echo: ".
# Set this to empty to repeat the user's text exactly:
# ECHO_PREFIX=
ECHO_PREFIX="echo: "

# Discord
# Developer Portal → your application → Bot → Token.
DISCORD_BOT_TOKEN=

# Slack
# OAuth & Permissions → Bot User OAuth Token, after you install the app.
# Starts with xoxb-.
SLACK_BOT_TOKEN=

# Basic Information → App-Level Tokens. Create one with the connections:write scope.
# Starts with xapp-. Required for Socket Mode.
SLACK_APP_TOKEN=

# Basic Information → App Credentials → Signing Secret.
# This Socket Mode bot does not read SLACK_SIGNING_SECRET.
# An HTTP Request URL app (not this scaffold) would need it to verify Slack's requests.
# SLACK_SIGNING_SECRET=
